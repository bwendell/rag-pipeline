# =============================================================================
# RAG Pipeline Configuration
# =============================================================================
# Copy this file to .env and update values as needed.
# All variables are prefixed with RAG_ for namespacing.

# -----------------------------------------------------------------------------
# Vector Store Configuration
# -----------------------------------------------------------------------------
RAG_VECTOR_STORE_TYPE=chroma
# Options: chroma, memory, oci, qdrant

# ChromaDB settings (when RAG_VECTOR_STORE_TYPE=chroma)
RAG_CHROMA_PERSIST_DIR=./data/chroma

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
RAG_LLM_PROVIDER_TYPE=ollama
# Options: ollama, oci, openai, anthropic

# Ollama settings (when RAG_LLM_PROVIDER_TYPE=ollama)
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=mistral

# OpenAI settings (when RAG_LLM_PROVIDER_TYPE=openai)
# RAG_OPENAI_API_KEY=sk-...
# RAG_OPENAI_MODEL=gpt-4

# OCI GenAI settings (when RAG_LLM_PROVIDER_TYPE=oci)
# RAG_OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example
# RAG_OCI_GENAI_ENDPOINT=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com
# RAG_OCI_GENAI_MODEL=cohere.command

# -----------------------------------------------------------------------------
# Embedding Provider Configuration
# -----------------------------------------------------------------------------
RAG_EMBEDDING_PROVIDER_TYPE=sentence_transformers
# Options: sentence_transformers, oci, openai

RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Chunking Configuration
# -----------------------------------------------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
RAG_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# OCI Configuration (for future use)
# -----------------------------------------------------------------------------
# OCI_CONFIG_FILE=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT
